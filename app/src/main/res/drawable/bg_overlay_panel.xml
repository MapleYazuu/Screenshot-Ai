<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮面板背景：20dp 圆角卡片。
  颜色引用 @color/overlay_panel_bg，该资源在 values-night 下有深色变体，
  因此这里不写死白色即可自动支持深色模式。
  stroke 用来模拟 elevation：WindowManager 的 TYPE_APPLICATION_OVERLAY 窗口
  没有父容器，android:elevation 不会投出阴影，描边是唯一稳定的“浮起”暗示。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/overlay_panel_bg" />

    <corners android:radius="@dimen/overlay_panel_corner" />

    <stroke
        android:width="@dimen/overlay_panel_stroke"
        android:color="@color/overlay_scrim" />

</shape>
