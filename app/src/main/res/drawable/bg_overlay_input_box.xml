<?xml version="1.0" encoding="utf-8"?>
<!-- 追问输入框容器：12dp 圆角 + 1dp 柔和描边 + 纯白（深色近黑）背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/overlay_input_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/overlay_input_stroke" />
</shape>
