<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  应用清单
  关键权限说明：
    SYSTEM_ALERT_WINDOW          悬浮窗（桌面常驻悬浮按钮）
    FOREGROUND_SERVICE           前台服务保活
    FOREGROUND_SERVICE_SPECIAL_USE  Android 14+ 要求的特殊用途前台服务类型
    POST_NOTIFICATIONS           Android 13+ 通知权限（前台服务通知）
    QUERY_ALL_PACKAGES           用于「开机自启/电池优化」引导跳转厂商设置页
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：调用各家 AI 接口 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启（可选，用户可在设置中开启） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 请求忽略电池优化，用于保活引导 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 震动反馈（开关切换的 HapticFeedback 在部分 ROM 上需要此权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 厂商设置页跳转需要查询组件可见性 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ScreenshotAiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenshotAI"
        tools:targetApi="34">

        <!-- ==================== 主界面 ==================== -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ScreenshotAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== 历史记录 ==================== -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScreenshotAI" />

        <!-- ==================== 预设指令管理 ==================== -->
        <activity
            android:name=".ui.preset.PresetActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScreenshotAI" />

        <!-- ==================== 设置 ==================== -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScreenshotAI" />

        <!-- ==================== 关于 ==================== -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScreenshotAI" />

        <!-- ==================== 快捷设置 Tile：悬浮工具栏开关 ==================== -->
        <service
            android:name=".service.FloatingToolbarTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_floating"
            android:label="@string/tile_floating_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ==================== 悬浮工具栏前台服务 ==================== -->
        <service
            android:name=".service.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_floating_toolbar_for_screenshot_ai" />
        </service>

        <!-- ==================== 无障碍截屏服务 ==================== -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ==================== 开机自启 ==================== -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!--
      Android 11+ 包可见性声明。
      注意：<queries> 必须是 <manifest> 的直接子元素（放在 <application> 内会导致 AAPT 报错），
      因此这里刻意与 <application> 平级。用于跳转厂商设置页与打开浏览器。
    -->
    <queries>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
